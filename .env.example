# SAHAJ — ENVIRONMENT VARIABLES CONFIGURATION (.env.example)

# Application & Environment
NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_SECRET=sahaj_development_jwt_secret_min32chars_required!
HMAC_SECRET=sahaj_development_hmac_secret_min32chars_required!

# Feature Flags
FF_VOICE=true
FF_N8N=true
FF_DOC_INLINE_FALLBACK=true
FF_JUDGE_MODE=true
FF_CHAOS=true
FF_PAYTM_SANDBOX=false

# Integration Mock Flags (Set to false when live keys are provided)
USE_MOCK_COGNEE=true
USE_MOCK_SARVAM=true
USE_MOCK_LLM=true
USE_MOCK_N8N=true

# Sponsor API Keys & Endpoints
COGNEE_API_KEY=your_cognee_api_key_here
COGNEE_API_URL=https://api.cognee.ai

SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_URL=https://api.sarvam.ai

LLM_API_KEY=your_llm_provider_key_here
LLM_PROVIDER=sarvam

N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_HMAC_SECRET=sahaj_n8n_hmac_secret_key

# Databases
MONGODB_URI=mongodb://localhost:27017/sahaj_dev
REDIS_URI=redis://localhost:6379
