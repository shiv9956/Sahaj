{
  "name": "Sahaj WF-4: Living Knowledge Freshness Watchdog Workflow",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "id": "node-schedule",
      "name": "Daily Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "requestMethod": "GET",
        "url": "http://localhost:3001/api/ready",
        "options": {}
      },
      "id": "node-check-freshness",
      "name": "Check Knowledge Source Dates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [320, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "http://localhost:3001/internal/n8n/knowledge/stale",
        "options": {}
      },
      "id": "node-stale-callback",
      "name": "Notify Stale Knowledge Callback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [540, 300]
    }
  ],
  "connections": {
    "Daily Schedule Trigger": {
      "main": [
        [
          {
            "node": "Check Knowledge Source Dates",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Knowledge Source Dates": {
      "main": [
        [
          {
            "node": "Notify Stale Knowledge Callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {}
}
